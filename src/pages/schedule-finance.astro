---
import Layout from '../layouts/Layout.astro';
import ScheduleFinance from '../components/tabs/ScheduleFinance.astro';
import { hemaDayRecords } from '../data/hema-records';
import { diaryRecords, specialEvents } from '../data/diary-data';
import { expenseRecords } from '../data/expense-data';
import { incomeRecords } from '../data/income-data';
import { utilityRecords } from '../data/utility-records';
import { expenseCategories } from '../data/expense-categories';
import { incomeCategories } from '../data/income-categories';
import { balanceBase } from '../data/balance-base';
import { membershipRecords } from '../data/membership-data';
---

<Layout activeTab="schedule-finance" title="日程和财务 · 猪窝">
  <ScheduleFinance />
  <script define:vars={{ hemaDayRecords, diaryRecords, specialEvents, expenseRecords, incomeRecords, utilityRecords, expenseCategories, incomeCategories, balanceBase, membershipRecords }}>
    window.__hemaDayRecords = hemaDayRecords;
    window.__diaryRecords = diaryRecords;
    window.__specialEvents = specialEvents;
    window.__expenseRecords = expenseRecords;
    window.__incomeRecords = incomeRecords;
    window.__utilityRecords = utilityRecords;
    window.__expenseCategories = expenseCategories;
    window.__incomeCategories = incomeCategories;
    window.__balanceBase = balanceBase;
    window.__membershipRecords = membershipRecords;
  </script>
  <script>
    import '../scripts/page';
  </script>
</Layout>
