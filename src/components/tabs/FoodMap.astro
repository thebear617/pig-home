---
import { getCollection } from 'astro:content';

const places = await getCollection('food-places');
const cityMap = new Map<string, Map<string, typeof places>>();
for (const place of places) {
  const city = place.data.city;
  const region = place.data.region;
  if (!cityMap.has(city)) cityMap.set(city, new Map());
  const regionMap = cityMap.get(city)!;
  if (!regionMap.has(region)) regionMap.set(region, []);
  regionMap.get(region)!.push(place);
}

const cityOrder = ['南宁', '西安', ...Array.from(cityMap.keys()).filter(city => !['南宁', '西安'].includes(city))]
  .filter(city => cityMap.has(city));
const defaultCity = cityOrder[0] || '';
const cityConfig = {
  南宁: { center: [108.366407, 22.8177], zoom: 11 },
  西安: { center: [108.939645, 34.343207], zoom: 11 },
};
const totalPlaces = places.length;
const mappedPlaces = places.filter(place =>
  place.data.coordinateStatus === 'confirmed' &&
  Number.isFinite(place.data.lng) &&
  Number.isFinite(place.data.lat)
).length;
const pendingPlaces = totalPlaces - mappedPlaces;

interface PlaceStatus { key: string; label: string; icon: string; }
const explicitStatus: Record<string, PlaceStatus> = {
  recommend: { key: 'recommend', label: '推荐', icon: '👍' },
  tried: { key: 'tried', label: '一般', icon: '🍽️' },
  no: { key: 'no', label: '不推荐', icon: '🚫' },
  wanna: { key: 'wanna', label: '还没去吃过', icon: '⭐' },
};
// 状态完全由 frontmatter 的 status 字段驱动，不再从 note 推断
function placeStatus(place: typeof places[0]): PlaceStatus {
  return explicitStatus[place.data.status] ?? explicitStatus.wanna;
}

// dishes 统一为对象格式 {name, note?, price?}
type Dish = { name: string; note: string; price: string };
function dishName(dish: Dish): string {
  return dish.name;
}
function dishNote(dish: Dish): string {
  return dish.note || '';
}
function dishPrice(dish: Dish): string {
  return dish.price || '';
}
function dishNames(place: typeof places[0]): string {
  return (place.data.dishes || []).map(dishName).join(' ');
}
// 把店的数据打包成可序列化的 JSON，供悬浮窗使用
const placePayload = places.map(p => ({
  id: p.id,
  name: p.data.name,
  city: p.data.city,
  region: p.data.region,
  category: p.data.category || '',
  address: p.data.address || '',
  date: p.data.date || '',
  note: p.data.note || '',
  lng: p.data.lng ?? null,
  lat: p.data.lat ?? null,
  coordinateStatus: p.data.coordinateStatus,
  status: placeStatus(p),
  statusKey: p.data.status,
  dishes: (p.data.dishes || []).map(d => ({ name: dishName(d), note: dishNote(d), price: dishPrice(d) })),
}));
const placePayloadJson = JSON.stringify(placePayload);

// 每个城市的菜系/地区可选值，供地图筛选按钮动态渲染
const cityFilters = Object.fromEntries(cityOrder.map(city => {
  const cityPlaces = places.filter(p => p.data.city === city);
  const categories = [...new Set(cityPlaces.map(p => p.data.category).filter(Boolean))];
  const regions = [...new Set(cityPlaces.map(p => p.data.region))];
  return [city, { categories, regions }];
}));
const cityFiltersJson = JSON.stringify(cityFilters);
---

<div class="foodmap-page" data-tab="food-map">
  <header class="foodmap-hero">
    <div class="foodmap-hero-copy">
      <p class="foodmap-hero-kicker">FOOD NOTES · 觅食记录</p>
      <div class="foodmap-hero-title-row">
        <h1 class="foodmap-hero-title">美食地图</h1>
        <p class="foodmap-hero-desc">把走过的街、记住的味道，慢慢收进这张地图里。</p>
      </div>
      <div class="foodmap-hero-chips" aria-label="美食地图数据概览">
        <span><b>{cityOrder.length}</b> 座城市</span>
        <span><b>{mappedPlaces}</b> 个已定位</span>
        <span><b>{pendingPlaces}</b> 个待补全</span>
      </div>
    </div>
    <div class="foodmap-hero-stat" title="共记录的美食店">
      <strong class="foodmap-hero-num">{totalPlaces}</strong>
      <span class="foodmap-hero-label">家记录</span>
      <small>持续收集中</small>
    </div>
  </header>

  <div class="foodmap-workspace" aria-label="美食地图工作台">
    <div class="foodmap-map-section">
    <div class="foodmap-map-toolbar">
      <div class="foodmap-city-switcher" role="tablist" aria-label="选择城市">
        <span class="foodmap-city-label">选择城市</span>
        {cityOrder.map(city => {
          const count = places.filter(place => place.data.city === city).length;
          return (
            <button
              class={`foodmap-city-button${city === defaultCity ? ' active' : ''}`}
              data-fm-city={city}
              role="tab"
              aria-selected={city === defaultCity}
              type="button"
            >
              <b>{city}</b><small>{count} 家</small>
            </button>
          );
        })}
      </div>
      <div class="foodmap-map-legend" aria-label="地图状态图例">
        <span><i class="foodmap-legend-dot is-mapped"></i>已定位</span>
        <span><i class="foodmap-legend-dot is-pending"></i>待补全</span>
      </div>
    </div>
    <div class="foodmap-map-filters">
      <div class="foodmap-map-searchbar">
        <span class="foodmap-map-search-icon" aria-hidden="true">🔍</span>
        <input type="search" data-fm-map-search placeholder="搜索店名、地点或备注" class="foodmap-map-search-input" />
        <button type="button" class="foodmap-filters-toggle" data-fm-filters-toggle aria-haspopup="dialog" aria-expanded="false">
          <span class="foodmap-filters-toggle-icon" aria-hidden="true">≡</span>
          <span class="foodmap-filters-toggle-label">筛选</span>
          <span class="foodmap-filters-badge" data-fm-filters-badge hidden>0</span>
        </button>
      </div>
      <div class="foodmap-filters-popover" data-fm-filters-popover role="dialog" aria-label="筛选" hidden>
        <div class="foodmap-filters-popover-head">
          <span class="foodmap-filters-popover-title">筛选</span>
          <button type="button" class="foodmap-filters-popover-close" data-fm-filters-close aria-label="关闭">✕</button>
        </div>
        <div class="foodmap-filters-popover-body">
          <div class="foodmap-filters-group">
            <div class="foodmap-filters-group-label">菜系</div>
            <div class="foodmap-filters-group-options" data-fm-filter-options="category"></div>
          </div>
          <div class="foodmap-filters-group">
            <div class="foodmap-filters-group-label">地区</div>
            <div class="foodmap-filters-group-options" data-fm-filter-options="region"></div>
          </div>
          <div class="foodmap-filters-group">
            <div class="foodmap-filters-group-label">状态</div>
            <div class="foodmap-filters-group-options" data-fm-filter-options="status"></div>
          </div>
        </div>
        <div class="foodmap-filters-popover-foot">
          <button type="button" class="foodmap-filters-clear" data-fm-filters-clear>清除筛选</button>
          <button type="button" class="foodmap-filters-done" data-fm-filters-done>完成</button>
        </div>
      </div>
    </div>
    <div class="foodmap-map-panel">
      <div class="foodmap-map-heading">
        <div>
          <p class="section-kicker">CITY MAP · 城市地图</p>
          <h2><span data-fm-map-city-label>{defaultCity}</span> 的味觉坐标</h2>
        </div>
        <span class="foodmap-map-count-wrap">
          <span data-fm-map-count>仅显示已确认坐标</span>
          <button type="button" class="foodmap-map-reset" data-fm-reset-map aria-label="恢复当前城市默认地图视图">↺ 恢复默认视图</button>
        </span>
      </div>
      <div class="foodmap-map" data-fm-map aria-label="美食地图"></div>
      <div class="foodmap-map-status" data-fm-map-status role="status">正在准备地图……</div>
    </div>
    <div class="foodmap-map-config" data-fm-city-config={JSON.stringify(cityConfig)} hidden></div>
    <div class="foodmap-map-filters-config" data-fm-city-filters={cityFiltersJson} hidden></div>
    </div>

    <div class="foodmap-right-column">
    <div class="foodmap-city-panels">
    {cityOrder.map(city => {
      const regionMap = cityMap.get(city)!;
      const regionOrder = Array.from(regionMap.keys()).sort();
      const defaultRegion = regionOrder[0] || '';
      return (
        <section class="foodmap-city-content" data-fm-city-content={city} hidden={city !== defaultCity}>
          <div class="foodmap-city-summary">
            <div>
              <p class="section-kicker">{city} · 觅食目录</p>
              <h2>从街区开始逛</h2>
              <div class="foodmap-directory-usage">
                <strong>选择一家餐厅</strong>
                <span>点击地图标记或下方目录，查看菜品、评价与地址。</span>
              </div>
            </div>
          </div>
          <div class="foodmap-directory-toolbar">
            <label class="foodmap-search">
              <span class="foodmap-directory-search-icon" aria-hidden="true">⌕</span>
              <input type="search" data-fm-search aria-label="搜索餐厅、菜品或评价" placeholder="搜索餐厅、菜品或评价" />
            </label>
            <div class="foodmap-region-list" aria-label={`${city} 区域导航`}>
              {regionOrder.map(region => {
                const items = regionMap.get(region) || [];
                return (
                  <button class={`foodmap-region-button${region === defaultRegion ? ' active' : ''}`} data-fm-region={region} aria-pressed={region === defaultRegion ? 'true' : 'false'} type="button">
                    <span><b>{region}</b><small>· {items.length}</small></span>
                    <span aria-hidden="true">›</span>
                  </button>
                );
              })}
            </div>
          </div>

          <main class="foodmap-results">
              {regionOrder.map(region => {
                const items = regionMap.get(region) || [];
                const hidden = region !== defaultRegion;
                return (
                  <div class="foodmap-region-content" data-fm-region-content={region} hidden={hidden}>
                    <div class="foodmap-list">
                      {items.map(place => {
                        const st = placeStatus(place);
                        const dishes = place.data.dishes || [];
                        const dishList = dishes.slice(0, 3).map(dishName).join(' · ');
                        const extraDishCount = Math.max(dishes.length - 3, 0);
                        const address = place.data.address || '';
                        const shortAddress = address.length > 10 ? `${address.slice(0, 10)}…` : address;
                        return (
                          <article
                            class="foodmap-list-item"
                            data-fm-search-text={`${place.data.city} ${place.data.region} ${place.data.name} ${place.data.category || ''} ${dishNames(place)} ${place.data.address || ''} ${place.data.note || ''}`}
                            data-fm-place={place.id}
                            role="button"
                            tabindex="0"
                          >
                            <div class="foodmap-list-top">
                              <div class="foodmap-list-title">
                                <h4 class="foodmap-list-name">{place.data.name}</h4>
                                {place.data.category && <span class="foodmap-cat-tag">{place.data.category}</span>}
                                <span class={`foodmap-status foodmap-status-${st.key}`}>{st.icon} {st.label}</span>
                              </div>
                              <span class={`foodmap-coordinate-state${place.data.coordinateStatus === 'confirmed' ? ' is-mapped' : ' is-pending'}`}>
                                {place.data.coordinateStatus === 'confirmed' ? '⌖ 已标注' : '＋ 待补坐标'}
                              </span>
                            </div>
                            {dishList && <p class="foodmap-dishes">{dishList}{extraDishCount > 0 && <span class="foodmap-dishes-more"> · +{extraDishCount} 道</span>}</p>}
                            <div class="foodmap-list-meta">
                              {address && <span class="foodmap-address" title={address}>📍 {shortAddress}</span>}
                              {place.data.date && <time datetime={place.data.date}>{place.data.date}</time>}
                              <span class="foodmap-list-detail-hint">查看详情 →</span>
                            </div>
                          </article>
                        );
                      })}
                    </div>
                    <p class="foodmap-no-results" hidden>没有匹配的记录</p>
                  </div>
                );
              })}
          </main>
        </section>
      );
    })}
    </div>
    </div>
  </div>

  <div class="foodmap-modal" data-fm-modal hidden>
    <div class="foodmap-modal-backdrop" data-fm-modal-close></div>
    <div class="foodmap-modal-panel" role="dialog" aria-modal="true" aria-labelledby="foodmap-modal-name" tabindex="-1">
      <div class="foodmap-modal-head">
        <div class="foodmap-modal-top">
          <span class="foodmap-modal-status foodmap-status-tried" data-fm-modal-status>🍽️ 已吃过</span>
          <button class="foodmap-modal-close" data-fm-modal-close type="button" aria-label="关闭">✕</button>
        </div>
        <h3 class="foodmap-modal-name" id="foodmap-modal-name"></h3>
        <div class="foodmap-modal-meta">
          <span class="foodmap-modal-tag" data-fm-modal-category hidden></span>
          <span class="foodmap-modal-loc" data-fm-modal-location></span>
          <span class="foodmap-modal-date" data-fm-modal-date hidden></span>
          <span class="foodmap-modal-map-state" data-fm-modal-map-state></span>
        </div>
        <p class="foodmap-modal-address" data-fm-modal-address hidden></p>
        <p class="foodmap-modal-note" data-fm-modal-note hidden></p>
      </div>
      <div class="foodmap-modal-body">
        <div class="foodmap-modal-section-title">菜品 & 评价</div>
        <ul class="foodmap-dish-list" data-fm-modal-dishes></ul>
      </div>
    </div>
  </div>
</div>

<div class="foodmap-payload" data-fm-places-json={placePayloadJson} hidden></div>

<script>
  const root = document.querySelector<HTMLElement>('[data-tab="food-map"]');

  function selectRegion(cityContent: HTMLElement, regionValue: string) {
    cityContent.querySelectorAll<HTMLButtonElement>('[data-fm-region]').forEach(button => {
      const active = button.dataset.fmRegion === regionValue;
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    cityContent.querySelectorAll<HTMLElement>('[data-fm-region-content]').forEach(content => {
      content.hidden = content.dataset.fmRegionContent !== regionValue;
    });
  }

  // 悬浮窗逻辑
  const PLACES: Record<string, any> = {};
  try {
    const el = document.querySelector<HTMLElement>('[data-fm-places-json]');
    if (el?.dataset.fmPlacesJson) {
      for (const p of JSON.parse(el.dataset.fmPlacesJson)) PLACES[p.id] = p;
    }
  } catch (e) {
    console.error('美食地图数据解析失败', e);
  }

  const modal = root?.querySelector<HTMLElement>('[data-fm-modal]');
  let modalReturnFocus: HTMLElement | null = null;
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const setText = (sel: string, value: string) => {
    const el = modal?.querySelector<HTMLElement>(sel);
    if (el) {
      if (value) { el.textContent = value; el.hidden = false; }
      else el.hidden = true;
    }
  };

  function clearPlaceSelection() {
    if (modal && !modal.hidden) closeModal();
    root?.querySelectorAll<HTMLElement>('[data-fm-place]').forEach(card => {
      card.classList.remove('is-active');
      card.removeAttribute('aria-current');
    });
  }

  function renderDetail(id: string) {
    const p = PLACES[id];
    if (!p) {
      clearPlaceSelection();
      return;
    }

    root?.querySelectorAll<HTMLElement>('[data-fm-place]').forEach(card => {
      const active = card.dataset.fmPlace === id;
      card.classList.toggle('is-active', active);
      if (active) card.setAttribute('aria-current', 'true');
      else card.removeAttribute('aria-current');
    });
  }

  function requestPlaceSelection(id: string, recenter = false) {
    root?.dispatchEvent(new CustomEvent('foodmap:select-place', {
      detail: { id, recenter },
    }));
  }

  root?.addEventListener('foodmap:select-place', event => {
    const detail = (event as CustomEvent<{ id?: string }>).detail;
    if (detail?.id) {
      renderDetail(detail.id);
      openModal(detail.id);
    }
    else clearPlaceSelection();
  });

  root?.addEventListener('foodmap:clear-place', () => {
    clearPlaceSelection();
  });

  root?.querySelectorAll<HTMLInputElement>('[data-fm-search]').forEach(search => {
    search.addEventListener('input', () => {
      root?.dispatchEvent(new CustomEvent('foodmap:search', {
        detail: { query: search.value },
      }));
    });
  });

  function openModal(id: string) {
    const p = PLACES[id];
    if (!p || !modal) return;
    setText('[data-fm-modal-name]', p.name);
    const placeLocation = [p.city, p.region].filter(Boolean).join(' · ');
    setText('[data-fm-modal-location]', placeLocation ? `📍 ${placeLocation}` : '');
    setText('[data-fm-modal-date]', p.date ? `📅 ${p.date}` : '');
    setText('[data-fm-modal-map-state]', p.coordinateStatus === 'confirmed' ? '⌖ 已标注在地图' : '＋ 待补充坐标');
    setText('[data-fm-modal-address]', p.address ? `📍 ${p.address}` : '');
    setText('[data-fm-modal-note]', p.note);
    const cat = modal.querySelector<HTMLElement>('[data-fm-modal-category]');
    if (cat) { cat.textContent = p.category; cat.hidden = !p.category; }
    const status = modal.querySelector<HTMLElement>('[data-fm-modal-status]');
    if (status) {
      status.textContent = `${p.status.icon} ${p.status.label}`;
      status.className = `foodmap-modal-status foodmap-status-${p.status.key}`;
    }
    const dishList = modal.querySelector<HTMLElement>('[data-fm-modal-dishes]');
    if (dishList) {
      dishList.innerHTML = p.dishes.length
        ? p.dishes.map((d: any) => `
          <li class="foodmap-dish">
            <div class="foodmap-dish-main">
              <span class="foodmap-dish-name">${esc(d.name)}</span>
              ${d.note ? `<p class="foodmap-dish-note">${esc(d.note)}</p>` : ''}
            </div>
            ${d.price ? `<span class="foodmap-dish-price">${esc(d.price)}</span>` : ''}
          </li>`).join('')
        : '<li class="foodmap-dish foodmap-dish-empty">还没有记录菜品</li>';
    }
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    modalReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    requestAnimationFrame(() => modal.querySelector<HTMLElement>('[data-fm-modal-close]')?.focus());
  }
  function closeModal() {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = '';
    const returnFocus = modalReturnFocus;
    modalReturnFocus = null;
    if (returnFocus?.isConnected) returnFocus.focus();
  }

  root?.addEventListener('click', event => {
    const target = event.target as HTMLElement;
    const regionButton = target.closest<HTMLButtonElement>('[data-fm-region]');
    if (regionButton) {
      const cityContent = regionButton.closest<HTMLElement>('[data-fm-city-content]');
      if (cityContent) {
        selectRegion(cityContent, regionButton.dataset.fmRegion || '');
        return;
      }
    }
    const detailClear = target.closest<HTMLElement>('[data-fm-detail-clear]');
    if (detailClear) {
      root?.dispatchEvent(new CustomEvent('foodmap:clear-place'));
      return;
    }
    const detailScrimTarget = target.closest<HTMLElement>('[data-fm-detail-scrim]');
    if (detailScrimTarget) {
      root?.dispatchEvent(new CustomEvent('foodmap:clear-place'));
      return;
    }
    const closeBtn = target.closest<HTMLElement>('[data-fm-modal-close]');
    if (closeBtn) { closeModal(); return; }
    const card = target.closest<HTMLElement>('[data-fm-place]');
    if (card) {
      requestPlaceSelection(card.dataset.fmPlace || '', true);
      return;
    }
  });
  root?.addEventListener('keydown', event => {
    const keyboardEvent = event as KeyboardEvent;
    if (keyboardEvent.key === 'Escape') {
      closeModal();
      root?.dispatchEvent(new CustomEvent('foodmap:clear-place'));
      return;
    }
    if (keyboardEvent.key === 'Tab' && modal && !modal.hidden) {
      const focusable = Array.from(modal.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      )).filter(el => !el.hasAttribute('disabled') && !el.hidden);
      if (focusable.length > 0) {
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (keyboardEvent.shiftKey && document.activeElement === first) {
          keyboardEvent.preventDefault();
          last.focus();
        } else if (!keyboardEvent.shiftKey && document.activeElement === last) {
          keyboardEvent.preventDefault();
          first.focus();
        }
      }
    }
    const card = (event.target as HTMLElement).closest<HTMLElement>('[data-fm-place]');
    if (card && (keyboardEvent.key === 'Enter' || keyboardEvent.key === ' ')) {
      keyboardEvent.preventDefault();
      requestPlaceSelection(card.dataset.fmPlace || '', true);
    }
  });
</script>

<script>
  const mapRoot = document.querySelector<HTMLElement>('[data-tab="food-map"]');
  const mapElement = mapRoot?.querySelector<HTMLElement>('[data-fm-map]');
  const mapStatus = mapRoot?.querySelector<HTMLElement>('[data-fm-map-status]');
  const mapCityLabel = mapRoot?.querySelector<HTMLElement>('[data-fm-map-city-label]');
  const mapCount = mapRoot?.querySelector<HTMLElement>('[data-fm-map-count]');
  const mapConfigElement = mapRoot?.querySelector<HTMLElement>('[data-fm-city-config]');
  // 坐标数据 payload 位于 foodmap-page 外层，不能从地图容器内部查询。
  const mapPlacesElement = document.querySelector<HTMLElement>('[data-fm-places-json]');
  const mapKey = import.meta.env.PUBLIC_AMAP_JS_KEY || '';
  const mapSecurityCode = import.meta.env.PUBLIC_AMAP_JS_SECURITY_CODE || '';

  type MapPlace = {
    id: string;
    name: string;
    city: string;
    region: string;
    category: string;
    address: string;
    note: string;
    dishes: { name: string; note?: string; price?: string }[];
    lng: number | null;
    lat: number | null;
    coordinateStatus: string;
    statusKey: string;
  };

  let mapPlaces: MapPlace[] = [];
  let cityConfig: Record<string, { center: [number, number]; zoom: number }> = {};
  let cityFilters: Record<string, { categories: string[]; regions: string[] }> = {};
  try {
    if (mapPlacesElement?.dataset.fmPlacesJson) mapPlaces = JSON.parse(mapPlacesElement.dataset.fmPlacesJson);
    if (mapConfigElement?.dataset.fmCityConfig) cityConfig = JSON.parse(mapConfigElement.dataset.fmCityConfig);
    const filtersEl = mapRoot?.querySelector<HTMLElement>('[data-fm-city-filters]');
    if (filtersEl?.dataset.fmCityFilters) cityFilters = JSON.parse(filtersEl.dataset.fmCityFilters);
  } catch (error) {
    console.error('美食地图地图数据解析失败', error);
  }

  let activeCity = mapRoot?.querySelector<HTMLElement>('[data-fm-city].active')?.dataset.fmCity || '';
  let activeCategory = '';
  let activeRegion = '';
  let activeStatus = '';
  let mapSearchQuery = '';
  let amap: any = null;
  let mapInstance: any = null;
  const markers = new Map<string, { instance: any; element: HTMLElement }>();
  let activeMarkerId = '';
  let selectedMapPlaceId = '';

  function setMapStatus(message: string, type = '') {
    if (!mapStatus) return;
    mapStatus.textContent = message;
    mapStatus.className = `foodmap-map-status${type ? ` is-${type}` : ''}`;
  }

  function placeSearchText(place: MapPlace) {
    return [
      place.name,
      place.region,
      place.category,
      place.address,
      place.note,
      ...(place.dishes || []).map(dish => dish.name),
    ].filter(Boolean).join(' ').toLocaleLowerCase();
  }

  // 目录和地图共用同一套城市、筛选和搜索条件。
  function matchesPlace(place: MapPlace, city: string) {
    const query = mapSearchQuery.trim().toLocaleLowerCase();
    return place.city === city &&
      (!activeCategory || place.category === activeCategory) &&
      (!activeRegion || place.region === activeRegion) &&
      (!activeStatus || place.statusKey === activeStatus) &&
      (!query || placeSearchText(place).includes(query));
  }

  // 地图只接受已确认坐标；目录会使用 matchesPlace() 显示所有符合条件的记录。
  function filteredPlaces(city: string) {
    return mapPlaces.filter(place =>
      matchesPlace(place, city) &&
      place.city === city &&
      place.coordinateStatus === 'confirmed' &&
      Number.isFinite(place.lng) &&
      Number.isFinite(place.lat)
    );
  }

  function syncDirectorySearchInputs() {
    mapRoot?.querySelectorAll<HTMLInputElement>('[data-fm-map-search], [data-fm-search]').forEach(input => {
      if (input.value !== mapSearchQuery) input.value = mapSearchQuery;
    });
  }

  function renderDirectoryRows(city = activeCity) {
    const cityContent = mapRoot?.querySelector<HTMLElement>(`[data-fm-city-content="${CSS.escape(city)}"]`);
    if (!cityContent) return;

    let firstMatchRegion = '';
    cityContent.querySelectorAll<HTMLElement>('[data-fm-region-content]').forEach(regionContent => {
      let visibleCount = 0;
      regionContent.querySelectorAll<HTMLElement>('[data-fm-place]').forEach(card => {
        const place = mapPlaces.find(item => item.id === card.dataset.fmPlace);
        const visible = !!place && matchesPlace(place, city);
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      const empty = regionContent.querySelector<HTMLElement>('.foodmap-no-results');
      if (empty) empty.hidden = visibleCount > 0;
      if (visibleCount > 0 && !firstMatchRegion) {
        firstMatchRegion = regionContent.dataset.fmRegionContent || '';
      }
    });

    // 搜索或地图区域筛选后，把目录切到第一个有结果的区域。
    if ((mapSearchQuery.trim() || activeRegion) && firstMatchRegion) {
      const currentRegion = cityContent.querySelector<HTMLElement>('[data-fm-region-content]:not([hidden])');
      if (currentRegion?.dataset.fmRegionContent !== firstMatchRegion) {
        const button = cityContent.querySelector<HTMLButtonElement>(
          `[data-fm-region="${CSS.escape(firstMatchRegion)}"]`
        );
        button?.click();
      }
    }
  }

  function applySearchQuery(query: string) {
    mapSearchQuery = query;
    syncDirectorySearchInputs();
    renderDirectoryRows(activeCity);
    renderMarkers(activeCity);
  }

  function focusPlace(id: string) {
    const place = mapPlaces.find(item => item.id === id);
    if (!place) return;
    selectedMapPlaceId = id;
    setActiveMarker(id);
    if (mapInstance && Number.isFinite(place.lng) && Number.isFinite(place.lat)) {
      mapInstance.setZoomAndCenter(16, [place.lng, place.lat]);
    }
    mapRoot?.dispatchEvent(new CustomEvent('foodmap:select-place', {
      detail: { id, recenter: false },
    }));
  }

  function setActiveMarker(id: string) {
    activeMarkerId = id;
    markers.forEach((marker, markerId) => {
      marker.element.classList.toggle('is-active', markerId === activeMarkerId);
    });
  }

  function resetMapView(city = activeCity) {
    if (!mapInstance) return;
    setActiveMarker('');

    const config = cityConfig[city];
    const cityMarkers = filteredPlaces(city)
      .map(place => markers.get(place.id)?.instance)
      .filter(Boolean);

    if (cityMarkers.length > 1) {
      mapInstance.setFitView(cityMarkers, false, [60, 60, 60, 60]);
    } else if (config) {
      mapInstance.setZoomAndCenter(config.zoom, config.center);
    }
  }

  function renderMarkers(city: string) {
    if (!mapInstance || !amap) {
      renderDirectoryRows(city);
      return;
    }
    markers.forEach(marker => marker.instance.setMap(null));
    markers.clear();
    activeMarkerId = '';

    const places = filteredPlaces(city);
    const selectedStillVisible = selectedMapPlaceId && mapPlaces.some(place =>
      place.id === selectedMapPlaceId && matchesPlace(place, city)
    );
    if (selectedMapPlaceId && !selectedStillVisible) {
      selectedMapPlaceId = '';
      mapRoot?.dispatchEvent(new CustomEvent('foodmap:clear-place'));
    }

    const nextMarkers = places.map(place => {
      const content = document.createElement('button');
      content.type = 'button';
      content.className = 'foodmap-poi-marker';
      content.setAttribute('aria-label', `查看${place.name}`);
      content.dataset.fmMarker = place.id;

      const dot = document.createElement('span');
      dot.className = 'foodmap-poi-marker-dot';
      dot.setAttribute('aria-hidden', 'true');
      dot.textContent = '✦';

      const label = document.createElement('span');
      label.className = 'foodmap-poi-marker-label';
      label.textContent = place.name;

      content.append(dot, label);
      const marker = new amap.Marker({
        position: [place.lng, place.lat],
        title: place.name,
        content,
        anchor: 'bottom-center',
        extData: { id: place.id },
      });
      marker.on('click', () => focusPlace(place.id));
      markers.set(place.id, { instance: marker, element: content });
      return marker;
    });

    if (nextMarkers.length > 0) {
      mapInstance.add(nextMarkers);
      resetMapView(city);
      if (selectedMapPlaceId && markers.has(selectedMapPlaceId)) setActiveMarker(selectedMapPlaceId);
      setMapStatus(`${city} 当前有 ${nextMarkers.length} 个已确认坐标的地点`);
    } else {
      resetMapView(city);
      setMapStatus(`${city} 暂时没有已确认坐标的美食点，列表仍可浏览`, 'empty');
    }
    if (mapCount) mapCount.textContent = `${places.length} 个已定位 · 其余待确认`;
    renderDirectoryRows(city);
  }

  // 筛选状态选项（4 档）
  const statusOptions = [
    { value: 'recommend', label: '推荐' },
    { value: 'tried', label: '一般' },
    { value: 'no', label: '不推荐' },
    { value: 'wanna', label: '还没去吃过' },
  ];

  function renderOptionsGroup(kind: 'category' | 'region' | 'status', values: string[], current: string, labelMap: Record<string, string> = {}) {
    const wrap = mapRoot?.querySelector<HTMLElement>(`[data-fm-filter-options="${kind}"]`);
    if (!wrap) return;
    wrap.innerHTML = '';
    const mkBtn = (value: string, label: string) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = `foodmap-chip${current === value ? ' active' : ''}`;
      b.dataset.fmFilter = kind;
      b.dataset.fmFilterValue = value;
      b.textContent = label;
      return b;
    };
    wrap.appendChild(mkBtn('', '全部'));
    for (const v of values) wrap.appendChild(mkBtn(v, labelMap[v] || v));
  }

  // 状态选项的 value → 中文 label 映射
  const statusLabelMap = Object.fromEntries(statusOptions.map(s => [s.value, s.label]));

  // 渲染菜系/地区/状态筛选按钮
  function renderFilters(city: string) {
    const data = cityFilters[city] || { categories: [], regions: [] };
    renderOptionsGroup('category', data.categories, activeCategory);
    renderOptionsGroup('region', data.regions, activeRegion);
    renderOptionsGroup('status', statusOptions.map(s => s.value), activeStatus, statusLabelMap);
    updateFiltersBadge();
  }

  function updateFiltersBadge() {
    const badge = mapRoot?.querySelector<HTMLElement>('[data-fm-filters-badge]');
    if (!badge) return;
    const count = (activeCategory ? 1 : 0) + (activeRegion ? 1 : 0) + (activeStatus ? 1 : 0);
    if (count > 0) {
      badge.textContent = String(count);
      badge.hidden = false;
    } else {
      badge.hidden = true;
    }
  }

  function toggleFiltersPopover(show: boolean) {
    const popover = mapRoot?.querySelector<HTMLElement>('[data-fm-filters-popover]');
    const toggle = mapRoot?.querySelector<HTMLElement>('[data-fm-filters-toggle]');
    if (!popover || !toggle) return;
    popover.hidden = !show;
    toggle.setAttribute('aria-expanded', String(show));
  }

  function clearAllFilters() {
    activeCategory = '';
    activeRegion = '';
    activeStatus = '';
    renderFilters(activeCity);
    renderDirectoryRows(activeCity);
    renderMarkers(activeCity);
  }

  function setMapCity(city: string) {
    activeCity = city;
    activeCategory = '';
    activeRegion = '';
    activeStatus = '';
    if (mapCityLabel) mapCityLabel.textContent = city;
    mapRoot?.querySelectorAll<HTMLElement>('[data-fm-city]').forEach(button => {
      const active = button.dataset.fmCity === city;
      button.classList.toggle('active', active);
      button.setAttribute('aria-selected', String(active));
    });
    mapRoot?.dispatchEvent(new CustomEvent('foodmap:clear-place'));
    // 同步切换目录城市内容面板
    mapRoot?.querySelectorAll<HTMLElement>('[data-fm-city-content]').forEach(content => {
      content.hidden = content.dataset.fmCityContent !== city;
    });
    renderFilters(city);
    renderDirectoryRows(city);
    renderMarkers(city);
  }

  function loadAmap() {
    const existing = (window as any).AMap;
    if (existing) return Promise.resolve(existing);
    if (!mapKey) return Promise.reject(new Error('未配置 PUBLIC_AMAP_JS_KEY'));

    const currentPromise = (window as any).__foodMapAmapPromise;
    if (currentPromise) return currentPromise;

    if (mapSecurityCode) {
      (window as any)._AMapSecurityConfig = { securityJsCode: mapSecurityCode };
    }

    (window as any).__foodMapAmapPromise = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.dataset.foodmapAmap = 'true';
      script.src = `https://webapi.amap.com/maps?v=2.0&key=${encodeURIComponent(mapKey)}`;
      script.async = true;
      script.onload = () => {
        const loaded = (window as any).AMap;
        loaded ? resolve(loaded) : reject(new Error('高德地图脚本加载后未找到 AMap'));
      };
      script.onerror = () => reject(new Error('高德地图脚本加载失败'));
      document.head.appendChild(script);
    });
    return (window as any).__foodMapAmapPromise;
  }

  async function initMap() {
    if (!mapElement) return;
    try {
      amap = await loadAmap();
      const config = cityConfig[activeCity] || { center: [108.366407, 22.8177], zoom: 11 };
      mapInstance = new amap.Map(mapElement, {
        viewMode: '2D',
        zoom: config.zoom,
        center: config.center,
        resizeEnable: true,
      });
      renderFilters(activeCity);
      renderMarkers(activeCity);
    } catch (error) {
      setMapStatus('地图暂未加载：请配置前端 JS API Key', 'error');
      console.warn('[food-map] AMap 初始化跳过:', error);
    }
  }

  mapRoot?.addEventListener('foodmap:select-place', event => {
    const detail = (event as CustomEvent<{ id?: string; recenter?: boolean }>).detail;
    const id = detail?.id || '';
    const place = mapPlaces.find(item => item.id === id);
    if (!place) return;

    selectedMapPlaceId = id;
    setActiveMarker(id);
    if (detail?.recenter && mapInstance && Number.isFinite(place.lng) && Number.isFinite(place.lat)) {
      mapInstance.setZoomAndCenter(16, [place.lng, place.lat]);
    }
  });

  mapRoot?.addEventListener('foodmap:clear-place', () => {
    selectedMapPlaceId = '';
    setActiveMarker('');
  });

  mapRoot?.addEventListener('foodmap:search', event => {
    const detail = (event as CustomEvent<{ query?: string }>).detail;
    applySearchQuery(detail?.query || '');
  });

  mapRoot?.addEventListener('click', event => {
    const target = event.target as HTMLElement;
    const resetButton = target.closest<HTMLElement>('[data-fm-reset-map]');
    if (resetButton) {
      resetMapView();
      return;
    }

    // 筛选按钮（打开/关闭弹窗）
    const filterToggle = target.closest<HTMLElement>('[data-fm-filters-toggle]');
    if (filterToggle) {
      const popover = mapRoot?.querySelector<HTMLElement>('[data-fm-filters-popover]');
      toggleFiltersPopover(!!popover && popover.hidden);
      return;
    }

    // 关闭弹窗
    if (target.closest('[data-fm-filters-close]')) {
      toggleFiltersPopover(false);
      return;
    }

    // 清除筛选
    if (target.closest('[data-fm-filters-clear]')) {
      clearAllFilters();
      return;
    }

    // 完成（关闭弹窗）
    if (target.closest('[data-fm-filters-done]')) {
      toggleFiltersPopover(false);
      return;
    }

    const cityButton = target.closest<HTMLElement>('[data-fm-city]');
    if (cityButton?.dataset.fmCity) setMapCity(cityButton.dataset.fmCity);

    // 弹窗内筛选按钮（菜系 / 地区 / 状态）
    const filterBtn = target.closest<HTMLElement>('[data-fm-filter]');
    if (filterBtn && mapRoot) {
      const kind = filterBtn.dataset.fmFilter;
      const value = filterBtn.dataset.fmFilterValue || '';
      if (kind === 'category') activeCategory = value;
      else if (kind === 'region') activeRegion = value;
      else if (kind === 'status') activeStatus = value;
      mapRoot.querySelectorAll<HTMLElement>(`[data-fm-filter="${kind}"]`).forEach(b => {
        b.classList.toggle('active', (b.dataset.fmFilterValue || '') === value);
      });
      updateFiltersBadge();
      renderMarkers(activeCity);
      return;
    }

    const placeCard = target.closest<HTMLElement>('[data-fm-place]');
    if (placeCard?.dataset.fmPlace) setActiveMarker(placeCard.dataset.fmPlace);
  });

  // 点击 popover 外部关闭
  document.addEventListener('click', event => {
    const popover = mapRoot?.querySelector<HTMLElement>('[data-fm-filters-popover]');
    if (!popover || popover.hidden) return;
    const target = event.target as HTMLElement;
    if (target.closest('[data-fm-filters-popover]') || target.closest('[data-fm-filters-toggle]')) return;
    toggleFiltersPopover(false);
  });

  // Esc 关闭弹窗
  document.addEventListener('keydown', event => {
    if ((event as KeyboardEvent).key === 'Escape') toggleFiltersPopover(false);
  });

  // 地图搜索框
  const mapSearch = mapRoot?.querySelector<HTMLInputElement>('[data-fm-map-search]');
  mapSearch?.addEventListener('input', () => {
    applySearchQuery(mapSearch.value);
  });

  initMap();
</script>
