---
import { getCollection } from 'astro:content';

const places = await getCollection('food-places');
const cityMap = new Map<string, Map<string, typeof places>>();
for (const place of places) {
  const city = place.data.city;
  const region = place.data.region;
  if (!cityMap.has(city)) cityMap.set(city, new Map());
  const regionMap = cityMap.get(city)!;
  if (!regionMap.has(region)) regionMap.set(region, []);
  regionMap.get(region)!.push(place);
}

const cityOrder = ['南宁', '西安', ...Array.from(cityMap.keys()).filter(city => !['南宁', '西安'].includes(city))]
  .filter(city => cityMap.has(city));
const defaultCity = cityOrder[0] || '';
const cityConfig = {
  南宁: { center: [108.366407, 22.8177], zoom: 11 },
  西安: { center: [108.939645, 34.343207], zoom: 11 },
};
const totalPlaces = places.length;
const mappedPlaces = places.filter(place =>
  place.data.coordinateStatus === 'confirmed' &&
  Number.isFinite(place.data.lng) &&
  Number.isFinite(place.data.lat)
).length;
const pendingPlaces = totalPlaces - mappedPlaces;

interface PlaceStatus { key: string; label: string; icon: string; }
const explicitStatus: Record<string, PlaceStatus> = {
  tried: { key: 'tried', label: '已吃过', icon: '🍽️' },
  recommend: { key: 'recommend', label: '推荐', icon: '👍' },
  wanna: { key: 'wanna', label: '想去试试', icon: '⭐' },
  no: { key: 'no', label: '不再推荐', icon: '🚫' },
};
function placeStatus(place: typeof places[0]): PlaceStatus {
  if (place.data.status) return explicitStatus[place.data.status];
  const note = place.data.note || '';
  if (/下次|想去|评价蛮高/.test(note)) return { key: 'wanna', label: '想去试试', icon: '⭐' };
  if (/再也不会|不好吃|不推荐|别去/.test(note)) return { key: 'no', label: '不再推荐', icon: '🚫' };
  if (/很不错|必点|绝了|好吃|推荐/.test(note)) return { key: 'recommend', label: '推荐', icon: '👍' };
  return { key: 'tried', label: '已吃过', icon: '🍽️' };
}

// dishes 兼容两种格式：纯字符串 或 {name,note,price}
type Dish = { name: string; note: string; price: string };
function dishName(dish: string | Dish): string {
  return typeof dish === 'string' ? dish : dish.name;
}
function dishNote(dish: string | Dish): string {
  return typeof dish === 'string' ? '' : dish.note || '';
}
function dishPrice(dish: string | Dish): string {
  return typeof dish === 'string' ? '' : dish.price || '';
}
function dishNames(place: typeof places[0]): string {
  return (place.data.dishes || []).map(dishName).join(' ');
}
// 把店的数据打包成可序列化的 JSON，供悬浮窗使用
const placePayload = places.map(p => ({
  id: p.id,
  name: p.data.name,
  city: p.data.city,
  region: p.data.region,
  category: p.data.category || '',
  address: p.data.address || '',
  date: p.data.date || '',
  note: p.data.note || '',
  tags: p.data.tags,
  lng: p.data.lng ?? null,
  lat: p.data.lat ?? null,
  coordinateStatus: p.data.coordinateStatus,
  coordinateSource: p.data.coordinateSource || '',
  status: placeStatus(p),
  dishes: (p.data.dishes || []).map(d => ({ name: dishName(d), note: dishNote(d), price: dishPrice(d) })),
}));
const placePayloadJson = JSON.stringify(placePayload);
---

<div class="foodmap-page" data-tab="food-map">
  <header class="foodmap-hero">
    <div class="foodmap-hero-copy">
      <p class="foodmap-hero-kicker">FOOD NOTES · 觅食记录</p>
      <h1 class="foodmap-hero-title">美食地图</h1>
      <p class="foodmap-hero-desc">按区域和地点，把去过、想吃和不再推荐的店都记下来。</p>
      <div class="foodmap-hero-chips" aria-label="美食地图数据概览">
        <span><b>{cityOrder.length}</b> 座城市</span>
        <span><b>{mappedPlaces}</b> 个已定位</span>
        <span><b>{pendingPlaces}</b> 个待补全</span>
      </div>
    </div>
    <div class="foodmap-hero-stat" title="共记录的美食店">
      <strong class="foodmap-hero-num">{totalPlaces}</strong>
      <span class="foodmap-hero-label">家记录</span>
      <small>持续收集中</small>
    </div>
  </header>

  <div class="foodmap-map-section">
    <div class="foodmap-map-toolbar">
      <div class="foodmap-city-switcher" role="tablist" aria-label="选择城市">
        <span class="foodmap-city-label">选择城市</span>
        {cityOrder.map(city => {
          const count = places.filter(place => place.data.city === city).length;
          return (
            <button
              class={`foodmap-city-button${city === defaultCity ? ' active' : ''}`}
              data-fm-city={city}
              role="tab"
              aria-selected={city === defaultCity}
              type="button"
            >
              <b>{city}</b><small>{count} 家</small>
            </button>
          );
        })}
      </div>
      <div class="foodmap-map-legend" aria-label="地图状态图例">
        <span><i class="foodmap-legend-dot is-mapped"></i>已定位</span>
        <span><i class="foodmap-legend-dot is-pending"></i>待补全</span>
      </div>
    </div>
    <div class="foodmap-map-panel">
      <div class="foodmap-map-heading">
        <div>
          <p class="section-kicker">CITY MAP · 城市地图</p>
          <h2><span data-fm-map-city-label>{defaultCity}</span> 的味觉坐标</h2>
        </div>
        <span class="foodmap-map-count-wrap">
          <span data-fm-map-count>仅显示已确认坐标</span>
          <button type="button" class="foodmap-map-reset" data-fm-reset-map aria-label="恢复当前城市默认地图视图">↺ 恢复默认视图</button>
        </span>
      </div>
      <div class="foodmap-map" data-fm-map aria-label="美食地图"></div>
      <div class="foodmap-map-status" data-fm-map-status role="status">正在准备地图……</div>
    </div>
    <div class="foodmap-map-helper">
      <span class="foodmap-map-helper-icon">⌖</span>
      <div><strong>地图和目录已经联动</strong><span>地图默认保持清爽，点击标记查看名称，再点卡片查看菜品与评价。</span></div>
    </div>
    <div class="foodmap-map-config" data-fm-city-config={JSON.stringify(cityConfig)} hidden></div>
  </div>

  <div class="foodmap-city-panels">
    {cityOrder.map(city => {
      const regionMap = cityMap.get(city)!;
      const regionOrder = Array.from(regionMap.keys()).sort();
      const defaultRegion = regionOrder[0] || '';
      const cityPlaces = places.filter(place => place.data.city === city);
      const cityMappedPlaces = cityPlaces.filter(place =>
        place.data.coordinateStatus === 'confirmed' &&
        Number.isFinite(place.data.lng) &&
        Number.isFinite(place.data.lat)
      ).length;
      return (
        <section class="foodmap-city-content" data-fm-city-content={city} hidden={city !== defaultCity}>
          <div class="foodmap-city-summary">
            <div>
              <p class="section-kicker">{city} · 觅食目录</p>
              <h2>从街区开始逛</h2>
              <p>先按区域缩小范围，再点开卡片看具体的菜品和评价。</p>
            </div>
            <div class="foodmap-city-summary-stats">
              <span><b>{cityPlaces.length}</b><small>家记录</small></span>
              <span><b>{cityMappedPlaces}</b><small>已定位</small></span>
              <span><b>{cityPlaces.length - cityMappedPlaces}</b><small>待补全</small></span>
            </div>
          </div>
          <div class="foodmap-layout">
            <aside class="foodmap-sidebar" aria-label={`${city} 美食地点导航`}>
              <label class="foodmap-search">
                <span>搜索记录</span>
                <input type="search" data-fm-search placeholder="餐厅、菜品或评价" />
              </label>
              <div class="foodmap-region-list">
                {regionOrder.map(region => {
                  const items = regionMap.get(region) || [];
                  return (
                    <button class={`foodmap-region-button${region === defaultRegion ? ' active' : ''}`} data-fm-region={region} type="button">
                      <span><b>{region}</b><small>{items.length} 家</small></span>
                      <span aria-hidden="true">›</span>
                    </button>
                  );
                })}
              </div>
            </aside>

            <main class="foodmap-results">
              {regionOrder.map(region => {
                const items = regionMap.get(region) || [];
                const hidden = region !== defaultRegion;
                return (
                  <div class="foodmap-region-content" data-fm-region-content={region} hidden={hidden}>
                    <div class="foodmap-results-heading">
                      <div><p class="section-kicker">{city} · {region}</p><h2>去哪吃</h2></div>
                      <span>{items.length} 家记录</span>
                    </div>
                    <div class="foodmap-list">
                      {items.map(place => {
                        const st = placeStatus(place);
                        const dishList = (place.data.dishes || []).map(dishName).join(' · ');
                        return (
                          <article
                            class="foodmap-list-item"
                            data-fm-search-text={`${place.data.city} ${place.data.region} ${place.data.name} ${place.data.category || ''} ${dishNames(place)} ${place.data.address || ''} ${place.data.note || ''} ${(place.data.tags || []).join(' ')}`}
                            data-fm-place={place.id}
                            role="button"
                            tabindex="0"
                          >
                            <div class="foodmap-list-main">
                              <div class="foodmap-list-top">
                                <h4 class="foodmap-list-name">{place.data.name}</h4>
                                {place.data.category && <span class="foodmap-cat-tag">{place.data.category}</span>}
                                <span class={`foodmap-status foodmap-status-${st.key}`}>{st.icon} {st.label}</span>
                              </div>
                              {dishList && <p class="foodmap-dishes">{dishList}</p>}
                              {place.data.note && <p class="foodmap-note">{place.data.note}</p>}
                            </div>
                            <div class="foodmap-list-side">
                              <span class={`foodmap-coordinate-state${place.data.coordinateStatus === 'confirmed' ? ' is-mapped' : ' is-pending'}`}>
                                {place.data.coordinateStatus === 'confirmed' ? '⌖ 已标注' : '＋ 待补坐标'}
                              </span>
                              {place.data.date && <time datetime={place.data.date}>{place.data.date}</time>}
                              {place.data.address && <span class="foodmap-address">📍 {place.data.address}</span>}
                            </div>
                          </article>
                        );
                      })}
                    </div>
                    <p class="foodmap-no-results" hidden>没有匹配的记录</p>
                  </div>
                );
              })}
            </main>
          </div>
        </section>
      );
    })}
  </div>

  <div class="foodmap-modal" data-fm-modal hidden>
    <div class="foodmap-modal-backdrop" data-fm-modal-close></div>
    <div class="foodmap-modal-panel" role="dialog" aria-modal="true" aria-labelledby="foodmap-modal-name">
      <div class="foodmap-modal-head">
        <div class="foodmap-modal-top">
          <span class="foodmap-modal-status foodmap-status-tried" data-fm-modal-status>🍽️ 已吃过</span>
          <button class="foodmap-modal-close" data-fm-modal-close type="button" aria-label="关闭">✕</button>
        </div>
        <h3 class="foodmap-modal-name" id="foodmap-modal-name"></h3>
        <div class="foodmap-modal-meta">
          <span class="foodmap-modal-tag" data-fm-modal-category hidden></span>
          <span class="foodmap-modal-loc" data-fm-modal-location></span>
          <span class="foodmap-modal-date" data-fm-modal-date hidden></span>
          <span class="foodmap-modal-map-state" data-fm-modal-map-state></span>
        </div>
        <p class="foodmap-modal-address" data-fm-modal-address hidden></p>
        <p class="foodmap-modal-note" data-fm-modal-note hidden></p>
      </div>
      <div class="foodmap-modal-body">
        <div class="foodmap-modal-section-title">菜品 & 评价</div>
        <ul class="foodmap-dish-list" data-fm-modal-dishes></ul>
      </div>
    </div>
  </div>
</div>

<div class="foodmap-payload" data-fm-places-json={placePayloadJson} hidden></div>

<script>
  const root = document.querySelector<HTMLElement>('[data-tab="food-map"]');

  function resetSearchResults(cityContent: HTMLElement) {
    cityContent.querySelectorAll<HTMLElement>('[data-fm-region-content]').forEach(region => {
      region.querySelectorAll<HTMLElement>('[data-fm-search-text]').forEach(item => { item.hidden = false; });
      const empty = region.querySelector<HTMLElement>('.foodmap-no-results');
      if (empty) empty.hidden = true;
    });
  }

  root?.querySelectorAll<HTMLInputElement>('[data-fm-search]').forEach(search => {
    search.addEventListener('input', () => {
      const query = search.value.trim().toLocaleLowerCase();
      const cityContent = search.closest<HTMLElement>('[data-fm-city-content]');
      if (!cityContent) return;

      if (!query) {
        resetSearchResults(cityContent);
        return;
      }

      let firstMatch: HTMLElement | null = null;
      cityContent.querySelectorAll<HTMLElement>('[data-fm-region-content]').forEach(region => {
        const items = region.querySelectorAll<HTMLElement>('[data-fm-search-text]');
        let visible = 0;
        items.forEach(item => {
          const match = (item.dataset.fmSearchText || '').toLocaleLowerCase().includes(query);
          item.hidden = !match;
          if (match) visible += 1;
        });

        const empty = region.querySelector<HTMLElement>('.foodmap-no-results');
        if (empty) empty.hidden = visible > 0;
        if (visible > 0 && !firstMatch) firstMatch = region;
      });

      // 搜索结果可能位于当前选中的区域之外，自动切换到第一个匹配区域。
      if (firstMatch) {
        const regionValue = firstMatch.dataset.fmRegionContent || '';
        const regionButton = cityContent.querySelector<HTMLButtonElement>(
          `[data-fm-region="${CSS.escape(regionValue)}"]`
        );
        regionButton?.click();
      }
    });
  });

  // 悬浮窗逻辑
  const PLACES: Record<string, any> = {};
  try {
    const el = document.querySelector<HTMLElement>('[data-fm-places-json]');
    if (el?.dataset.fmPlacesJson) {
      for (const p of JSON.parse(el.dataset.fmPlacesJson)) PLACES[p.id] = p;
    }
  } catch (e) {
    console.error('美食地图数据解析失败', e);
  }

  const modal = root?.querySelector<HTMLElement>('[data-fm-modal]');
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const setText = (sel: string, value: string) => {
    const el = modal?.querySelector<HTMLElement>(sel);
    if (el) {
      if (value) { el.textContent = value; el.hidden = false; }
      else el.hidden = true;
    }
  };

  function openModal(id: string) {
    const p = PLACES[id];
    if (!p || !modal) return;
    setText('[data-fm-modal-name]', p.name);
    const placeLocation = [p.city, p.region].filter(Boolean).join(' · ');
    setText('[data-fm-modal-location]', placeLocation ? `📍 ${placeLocation}` : '');
    setText('[data-fm-modal-date]', p.date ? `📅 ${p.date}` : '');
    setText('[data-fm-modal-map-state]', p.coordinateStatus === 'confirmed' ? '⌖ 已标注在地图' : '＋ 待补充坐标');
    setText('[data-fm-modal-address]', p.address ? `📍 ${p.address}` : '');
    setText('[data-fm-modal-note]', p.note);
    const cat = modal.querySelector<HTMLElement>('[data-fm-modal-category]');
    if (cat) { cat.textContent = p.category; cat.hidden = !p.category; }
    const status = modal.querySelector<HTMLElement>('[data-fm-modal-status]');
    if (status) {
      status.textContent = `${p.status.icon} ${p.status.label}`;
      status.className = `foodmap-modal-status foodmap-status-${p.status.key}`;
    }
    const dishList = modal.querySelector<HTMLElement>('[data-fm-modal-dishes]');
    if (dishList) {
      dishList.innerHTML = p.dishes.length
        ? p.dishes.map((d: any) => `
          <li class="foodmap-dish">
            <div class="foodmap-dish-main">
              <span class="foodmap-dish-name">${esc(d.name)}</span>
              ${d.note ? `<p class="foodmap-dish-note">${esc(d.note)}</p>` : ''}
            </div>
            ${d.price ? `<span class="foodmap-dish-price">${esc(d.price)}</span>` : ''}
          </li>`).join('')
        : '<li class="foodmap-dish foodmap-dish-empty">还没有记录菜品</li>';
    }
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  root?.addEventListener('click', event => {
    const target = event.target as HTMLElement;
    const closeBtn = target.closest<HTMLElement>('[data-fm-modal-close]');
    if (closeBtn) { closeModal(); return; }
    const card = target.closest<HTMLElement>('[data-fm-place]');
    if (card) { openModal(card.dataset.fmPlace || ''); return; }
  });
  root?.addEventListener('keydown', event => {
    if ((event as KeyboardEvent).key === 'Escape') closeModal();
  });
</script>

<script>
  const mapRoot = document.querySelector<HTMLElement>('[data-tab="food-map"]');
  const mapElement = mapRoot?.querySelector<HTMLElement>('[data-fm-map]');
  const mapStatus = mapRoot?.querySelector<HTMLElement>('[data-fm-map-status]');
  const mapCityLabel = mapRoot?.querySelector<HTMLElement>('[data-fm-map-city-label]');
  const mapCount = mapRoot?.querySelector<HTMLElement>('[data-fm-map-count]');
  const mapConfigElement = mapRoot?.querySelector<HTMLElement>('[data-fm-city-config]');
  // 坐标数据 payload 位于 foodmap-page 外层，不能从地图容器内部查询。
  const mapPlacesElement = document.querySelector<HTMLElement>('[data-fm-places-json]');
  const mapKey = import.meta.env.PUBLIC_AMAP_JS_KEY || '';
  const mapSecurityCode = import.meta.env.PUBLIC_AMAP_JS_SECURITY_CODE || '';

  type MapPlace = {
    id: string;
    name: string;
    city: string;
    region: string;
    lng: number | null;
    lat: number | null;
    coordinateStatus: string;
  };

  let mapPlaces: MapPlace[] = [];
  let cityConfig: Record<string, { center: [number, number]; zoom: number }> = {};
  try {
    if (mapPlacesElement?.dataset.fmPlacesJson) mapPlaces = JSON.parse(mapPlacesElement.dataset.fmPlacesJson);
    if (mapConfigElement?.dataset.fmCityConfig) cityConfig = JSON.parse(mapConfigElement.dataset.fmCityConfig);
  } catch (error) {
    console.error('美食地图地图数据解析失败', error);
  }

  let activeCity = mapRoot?.querySelector<HTMLElement>('[data-fm-city].active')?.dataset.fmCity || '';
  let amap: any = null;
  let mapInstance: any = null;
  const markers = new Map<string, { instance: any; element: HTMLElement }>();
  let activeMarkerId = '';

  function setMapStatus(message: string, type = '') {
    if (!mapStatus) return;
    mapStatus.textContent = message;
    mapStatus.className = `foodmap-map-status${type ? ` is-${type}` : ''}`;
  }

  function confirmedPlaces(city: string) {
    return mapPlaces.filter(place =>
      place.city === city &&
      place.coordinateStatus === 'confirmed' &&
      Number.isFinite(place.lng) &&
      Number.isFinite(place.lat)
    );
  }

  function focusPlace(id: string) {
    const place = mapPlaces.find(item => item.id === id);
    if (!place || !mapInstance || !Number.isFinite(place.lng) || !Number.isFinite(place.lat)) return;
    setActiveMarker(id);
    mapInstance.setZoomAndCenter(16, [place.lng, place.lat]);
    const card = mapRoot?.querySelector<HTMLElement>(`[data-fm-place="${CSS.escape(id)}"]`);
    card?.click();
  }

  function setActiveMarker(id: string) {
    activeMarkerId = id;
    markers.forEach((marker, markerId) => {
      marker.element.classList.toggle('is-active', markerId === activeMarkerId);
    });
  }

  function resetMapView(city = activeCity) {
    if (!mapInstance) return;
    setActiveMarker('');

    const config = cityConfig[city];
    const cityMarkers = confirmedPlaces(city)
      .map(place => markers.get(place.id)?.instance)
      .filter(Boolean);

    if (cityMarkers.length > 1) {
      mapInstance.setFitView(cityMarkers, false, [60, 60, 60, 60]);
    } else if (config) {
      mapInstance.setZoomAndCenter(config.zoom, config.center);
    }
  }

  function renderMarkers(city: string) {
    if (!mapInstance || !amap) return;
    markers.forEach(marker => marker.instance.setMap(null));
    markers.clear();
    activeMarkerId = '';

    const places = confirmedPlaces(city);

    const nextMarkers = places.map(place => {
      const content = document.createElement('button');
      content.type = 'button';
      content.className = 'foodmap-poi-marker';
      content.setAttribute('aria-label', `查看${place.name}`);
      content.dataset.fmMarker = place.id;

      const dot = document.createElement('span');
      dot.className = 'foodmap-poi-marker-dot';
      dot.setAttribute('aria-hidden', 'true');
      dot.textContent = '✦';

      const label = document.createElement('span');
      label.className = 'foodmap-poi-marker-label';
      label.textContent = place.name;

      content.append(dot, label);
      const marker = new amap.Marker({
        position: [place.lng, place.lat],
        title: place.name,
        content,
        anchor: 'bottom-center',
        extData: { id: place.id },
      });
      marker.on('click', () => focusPlace(place.id));
      markers.set(place.id, { instance: marker, element: content });
      return marker;
    });

    if (nextMarkers.length > 0) {
      mapInstance.add(nextMarkers);
      resetMapView(city);
      setMapStatus(`${city} 当前有 ${nextMarkers.length} 个已确认坐标的地点`);
    } else {
      resetMapView(city);
      setMapStatus(`${city} 暂时没有已确认坐标的美食点，列表仍可浏览`, 'empty');
    }
    if (mapCount) mapCount.textContent = `${places.length} 个已定位 · 其余待确认`;
  }

  function setMapCity(city: string) {
    activeCity = city;
    if (mapCityLabel) mapCityLabel.textContent = city;
    renderMarkers(city);
  }

  function loadAmap() {
    const existing = (window as any).AMap;
    if (existing) return Promise.resolve(existing);
    if (!mapKey) return Promise.reject(new Error('未配置 PUBLIC_AMAP_JS_KEY'));

    const currentPromise = (window as any).__foodMapAmapPromise;
    if (currentPromise) return currentPromise;

    if (mapSecurityCode) {
      (window as any)._AMapSecurityConfig = { securityJsCode: mapSecurityCode };
    }

    (window as any).__foodMapAmapPromise = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.dataset.foodmapAmap = 'true';
      script.src = `https://webapi.amap.com/maps?v=2.0&key=${encodeURIComponent(mapKey)}`;
      script.async = true;
      script.onload = () => {
        const loaded = (window as any).AMap;
        loaded ? resolve(loaded) : reject(new Error('高德地图脚本加载后未找到 AMap'));
      };
      script.onerror = () => reject(new Error('高德地图脚本加载失败'));
      document.head.appendChild(script);
    });
    return (window as any).__foodMapAmapPromise;
  }

  async function initMap() {
    if (!mapElement) return;
    try {
      amap = await loadAmap();
      const config = cityConfig[activeCity] || { center: [108.366407, 22.8177], zoom: 11 };
      mapInstance = new amap.Map(mapElement, {
        viewMode: '2D',
        zoom: config.zoom,
        center: config.center,
        resizeEnable: true,
      });
      renderMarkers(activeCity);
    } catch (error) {
      setMapStatus('地图暂未加载：请配置前端 JS API Key', 'error');
      console.warn('[food-map] AMap 初始化跳过:', error);
    }
  }

  mapRoot?.addEventListener('click', event => {
    const target = event.target as HTMLElement;
    const resetButton = target.closest<HTMLElement>('[data-fm-reset-map]');
    if (resetButton) {
      resetMapView();
      return;
    }

    const cityButton = target.closest<HTMLElement>('[data-fm-city]');
    if (cityButton?.dataset.fmCity) setMapCity(cityButton.dataset.fmCity);

    const placeCard = target.closest<HTMLElement>('[data-fm-place]');
    if (placeCard?.dataset.fmPlace) setActiveMarker(placeCard.dataset.fmPlace);
  });

  initMap();
</script>
