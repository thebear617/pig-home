---
import DailyTracker from './DailyTracker.astro';
import ExpenseRecords from './ExpenseRecords.astro';
import MembershipSubscriptions from './MembershipSubscriptions.astro';

const base = import.meta.env.BASE_URL;
const currentYear = new Date().getFullYear();
---

<div class="sf-page" data-tab="schedule-finance">
  <div class="sf-top-spacer" aria-hidden="true"></div>
  <header class="sf-hero">
    <div class="sf-hero-copy">
      <button class="sf-hero-brand" type="button" data-sf-view-btn="daily-tracker" aria-label="返回日程和财务">
        <span class="sf-hero-title-row">
          <h1>日程和财务</h1>
          <svg class="sf-hero-mark" viewBox="0 0 90 30" aria-hidden="true"><path d="M2 22c13-2 23-10 35-9 8 1-5 7 3 9 7 4 25-11 53-8" /></svg>
        </span>
      </button>
    </div>
    <div class="sf-month-switcher" aria-label="月份切换">
      <button class="sf-month-button cal-prev" type="button" aria-label="上个月">◀</button>
      <strong class="sf-month-title" data-sf-month-title>2026年9月</strong>
      <button class="sf-month-button cal-next" type="button" aria-label="下个月">▶</button>
      <button class="sf-current-month cal-today-btn" type="button">本月</button>
    </div>
    <div class="sf-hero-decoration" aria-hidden="true">
      <img src={`${base}images/schedule-finance-hero-decoration.png`} alt="" />
    </div>
  </header>

  <div class="sf-primary-layout">
      <section class="sf-kpi-row" aria-label="本月概览">
        <article class="sf-kpi-card">
          <span class="sf-kpi-icon is-balance" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 8.5h13.5a2.5 2.5 0 0 1 0 5H4z" /><path d="M4 8.5V6.8A1.8 1.8 0 0 1 5.8 5h11.7A2.5 2.5 0 0 1 20 7.5v6" /><circle cx="17" cy="11" r="1" /></svg></span>
          <div class="sf-kpi-copy"><span>可支配余额</span><strong data-sf-kpi="balance">—</strong></div>
          <span class="sf-kpi-arrow" aria-hidden="true">›</span>
        </article>
        <article class="sf-kpi-card">
          <span class="sf-kpi-icon is-expense" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 3.5v3M16 3.5v3M4 10h16M8 14h.01M12 14h.01M16 14h.01M8 17h.01M12 17h.01" /></svg></span>
          <div class="sf-kpi-copy"><span>本月支出</span><strong data-sf-kpi="expense">—</strong></div>
          <span class="sf-kpi-arrow" aria-hidden="true">›</span>
        </article>
        <article class="sf-kpi-card">
          <span class="sf-kpi-icon is-daily" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 19V11M12 19V6M19 19V3" /></svg></span>
          <div class="sf-kpi-copy"><span>日均支出</span><strong data-sf-kpi="daily-expense">—</strong></div>
          <span class="sf-kpi-arrow" aria-hidden="true">›</span>
        </article>
        <article class="sf-kpi-card">
          <span class="sf-kpi-icon is-study" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21V5.5Z" /><path d="M4 5.5V21M8 7h8M8 11h6" /></svg></span>
          <div class="sf-kpi-copy"><span>学习均值</span><strong data-sf-kpi="study">—</strong></div>
          <span class="sf-kpi-arrow" aria-hidden="true">›</span>
        </article>
        <article class="sf-kpi-card is-renewal">
          <span class="sf-kpi-icon is-renewal-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4 7 4.2 3L12 5l3.8 5L20 7l-1.5 11H5.5Z" fill="currentColor" stroke="none" /><path d="M5.5 20h13" /></svg></span>
          <div class="sf-kpi-copy"><span>7天内续费</span><strong data-sf-kpi="renewal">—</strong></div>
          <span class="sf-kpi-arrow" aria-hidden="true">›</span>
        </article>
      </section>
    <section class="sf-view" data-sf-view="daily-tracker" role="tabpanel" aria-label="每日追踪">
      <DailyTracker />
    </section>
  </div>

  <section class="sf-view" data-sf-view="expense-records" role="tabpanel" aria-label="收支记录" hidden>
    <ExpenseRecords />
  </section>

  <section class="sf-view" data-sf-view="membership" role="tabpanel" aria-label="会员订阅" hidden>
    <MembershipSubscriptions />
  </section>

  <footer class="sf-footer">
    <span>猪窝&nbsp;—&nbsp;记录生活的每一天，让平凡的日子也闪闪发光&nbsp;♡</span>
    <span>{currentYear}&nbsp;·&nbsp;Have a nice day&nbsp;☼</span>
  </footer>
</div>
