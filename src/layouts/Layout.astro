---
import '../styles/global.css';
import { TABS } from '../lib/tabs';

interface Props {
  activeTab: string;
  title?: string;
}

const { activeTab, title = '猪窝' } = Astro.props;
const base = import.meta.env.BASE_URL;
const lineIconAttrs = 'fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"';
const tabIcons: Record<string, string> = {
  'home-archive': `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m3.5 10 8.5-7 8.5 7v10H14v-6H10v6H3.5Z" ${lineIconAttrs}/></svg>`,
  'food-records': `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="13" r="7.5" ${lineIconAttrs}/><path d="M8 3.5v6.5M6 3.5v6.5a2 2 0 0 0 4 0V3.5M8 12v8.5M16 3.5v17M16 3.5c2 1.6 2 4.7 0 6.3" ${lineIconAttrs}/></svg>`,
  'todo-board': `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="4" width="16" height="16" rx="2" ${lineIconAttrs}/><path d="M8 8h.01M11 8h5M8 12h.01M11 12h5M8 16h.01M11 16h5" ${lineIconAttrs}/></svg>`,
  'daily-tracker': `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="5.5" width="16" height="15" rx="2" ${lineIconAttrs}/><path d="M8 3.5v4M16 3.5v4M4 10h16M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01" ${lineIconAttrs}/></svg>`,
  'expense-records': `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7.5h14a2 2 0 0 1 2 2v9H4a2 2 0 0 1-2-2V7.5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2" ${lineIconAttrs}/><path d="M16 12h4M16 12a2 2 0 1 0 0 4h4v-4" ${lineIconAttrs}/></svg>`,
  membership: `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="5" width="17" height="14" rx="2" ${lineIconAttrs}/><path d="M3.5 10h17M7 14.5h4" ${lineIconAttrs}/></svg>`,
  'food-map': `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10Z" ${lineIconAttrs}/><circle cx="12" cy="10" r="2" ${lineIconAttrs}/></svg>`,
  'relationship-timeline': `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.2S4.5 15.7 4.5 9.4A4.2 4.2 0 0 1 12 7.1a4.2 4.2 0 0 1 7.5 2.3c0 6.3-7.5 10.8-7.5 10.8Z" ${lineIconAttrs}/></svg>`,
  'couple-album': `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 8h3l1.5-2h7L17 8h3v10H4Z" ${lineIconAttrs}/><circle cx="12" cy="13" r="3.2" ${lineIconAttrs}/></svg>`,
};
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <title>{title}</title>
  </head>
  <body data-page={activeTab} class="sidebar-collapsed">
    <div class="layout">
      <button
        class="sidebar-toggle"
        id="sidebarToggle"
        type="button"
        aria-label="展开侧边栏"
        aria-expanded="false"
      ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
      <div class="sidebar-backdrop" id="sidebarBackdrop" hidden></div>

      <nav class="sidebar" id="sidebar" aria-label="主导航">
        <div class="sidebar-brand">
          <button class="sidebar-close" id="sidebarClose" type="button" aria-label="关闭侧边栏"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
          <button class="sidebar-collapse" id="sidebarCollapse" type="button" aria-label="收起侧边栏" title="收起侧边栏">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="4" width="17" height="16" rx="2"></rect><path d="M9 4v16"></path><path d="m15 9-3 3 3 3"></path></svg>
          </button>
          <svg class="sidebar-home-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M11 17h3v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a3.16 3.16 0 0 0 2-2h1a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1h-1a5 5 0 0 0-2-4V3a4 4 0 0 0-3.2 1.6l-.3.4H11a6 6 0 0 0-6 6v1a5 5 0 0 0 2 4v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1z"></path><path d="M16 10h.01"></path><path d="M2 8v1a2 2 0 0 0 2 2h1"></path></svg>
          <p class="sidebar-eyebrow">PIG HOME</p>
          <h1 class="sidebar-title">我们的小家</h1>
          <span class="sidebar-subtitle">猪窝</span>
        </div>
        <div class="sidebar-nav" id="sidebarNav">
          {TABS.map(tab => (
            <a
              class={`sidebar-item${tab.id === activeTab ? ' active' : ''}`}
              href={`${base}${tab.id}/`}
              aria-current={tab.id === activeTab ? 'page' : undefined}
            >
              <span class="sidebar-icon" aria-hidden="true" set:html={tabIcons[tab.id] ?? tabIcons['home-archive']} />
              <span>{tab.title}</span>
            </a>
          ))}
        </div>
      </nav>

      <div class="main-area">
        <main id="app" class="app-shell">
          <slot />
        </main>
      </div>
    </div>

    <script>
      import '../scripts/layout';
    </script>
  </body>
</html>
